; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Adventure RPG Alpha"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/textures/space/galaxy.svg"

[file_customization]

folder_colors={
"res://actions/": "orange",
"res://actions/components/": "red",
"res://actions/components/options/view/": "green",
"res://actions/components/potency/action_potency_stat/view/": "green",
"res://assets/": "purple",
"res://data/": "gray",
"res://galaxy/": "blue",
"res://galaxy/entities/celestial/planet/actions/": "orange",
"res://galaxy/entities/celestial/planet/components/": "red",
"res://galaxy/entities/celestial/planet/site/actions/": "orange",
"res://galaxy/entities/misc/agent/components/": "red",
"res://galaxy/entities/misc/agent/components/stats/stats/": "gray",
"res://interface/": "green"
}

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
